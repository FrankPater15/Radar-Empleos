# Copia este archivo como .env y ajusta lo que necesites.
# SQLite local por defecto. Para Postgres (Neon/Supabase): pip install "psycopg[binary]" y usa
# DATABASE_URL=postgresql+psycopg://usuario:clave@host/basedatos
DATABASE_URL=sqlite:///radar.db

# Fuentes (APIs públicas): getonbrd, himalayas, jobicy
SOURCES=getonbrd,himalayas,jobicy
GETONBRD_CATEGORIES=programming,technical-support,sysadmin-devops-qa,mobile-developer,machine-learning-ai,data-science-analytics
GETONBRD_MAX_PAGES=5
GETONBRD_PER_PAGE=50
HIMALAYAS_MAX_PAGES=3
JOBICY_INDUSTRIES=engineering,qa-testing,technical-support,data-science
# Búsquedas de texto en Get on Board y Himalayas (separadas por comas)
SEARCH_QUERIES=junior developer,desarrollador junior,trainee,practicante,entry level,qa automation,rpa,automatizacion,soporte de aplicaciones,implementacion de software,full stack,python,react,node,angular,flutter,.net

# Prefiltro local: habilidades que suman afinidad y afinidad mínima (0-100) para gastar IA
SKILLS=python,javascript,typescript,node,react,angular,flutter,dart,c#,.net,sql,mongodb,supabase,rpa,ocr,rest,git,ci/cd,pruebas automatizadas,testing,qa,microsoft graph,express,tailwind,vite,azure
MIN_FIT=45

# Fase 2: puntuación con IA
CV_PATH=cv/cv_maestro.md
SCORING_PROVIDER=gemini            # gemini (capa gratuita) | anthropic

# Gemini: key gratis en https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite   # se usa si el principal está saturado (503)

# Claude (de pago): key en https://platform.claude.com
ANTHROPIC_API_KEY=
SCORING_MODEL=claude-opus-5-5
SCORING_EFFORT=low
